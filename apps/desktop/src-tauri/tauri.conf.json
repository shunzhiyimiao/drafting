{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drafting",
  "version": "0.1.0",
  "identifier": "com.drafting.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @drafting/codegen-server build && pnpm --filter @drafting/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Drafting",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../packages/codegen-server/dist/codegen-server.cjs": "codegen-server/codegen-server.cjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
